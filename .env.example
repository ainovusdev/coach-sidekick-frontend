# Copy to .env.local. The frontend has no secrets of its own beyond PostHog.
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_WS_URL=ws://localhost:8001
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Build-time only: enables source-map upload in next.config.ts
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
# Local dev: force every PostHog feature flag on
# NEXT_PUBLIC_FEATURE_FLAGS_FORCE_ON=true
